# Local developer settings (copy to .env; .env is ignored by Git).
# Jewel Case's own build settings live in jewelcase.mk; anything set here overrides them.

# PS5 address for `make deploy` (FTP)
PS5_HOST=192.168.1.100
FTP_PORT=2121
DEPLOY_DRY_RUN=0

# Defaults to all available logical CPUs; lower this on memory-limited hosts.
# BUILD_JOBS=8
# USE_CCACHE=0
